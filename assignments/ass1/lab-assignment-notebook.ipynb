    "class RawImages(Dataset):\n",
    "    def __init__(self, dataset, ids):\n",
    "        self.dataset = dataset\n",
    "        self.ids = list(map(int, ids))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.ids)\n",
    "\n",
    "    def __getitem__(self, idx):  # ty: ignore[lost-keyword-for-regular-parameter]\n",
    "        image_id = self.ids[idx]\n",
    "        image, target = self.dataset[image_id]\n",
    "        return TF.to_tensor(image), int(target), image_id"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_inputs(raw, stats):\n",
    "    mean = raw.new_tensor(stats[\"mean\"])[None, :, None, None]\n",
    "    std = raw.new_tensor(stats[\"std\"])[None, :, None, None]\n",
    "    return (raw - mean) / std"
   ]
  },
