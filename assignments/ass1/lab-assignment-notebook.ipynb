      "source": [
        "@dataclass\n",
        "class Metrics:\n",
        "    loss: float\n",
        "    accuracy: float\n",
        "    samples: int\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class EpochResult:\n",
        "    epoch: int\n",
        "    train_loss: float\n",
        "    train_accuracy: float\n",
        "    val_loss: float\n",
        "    val_accuracy: float\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class RunSummary:\n",
        "    name: str\n",
        "    group: str\n",
        "    model: str\n",
        "    smoke: bool\n",
        "    epochs: int\n",
        "    dropout: float\n",
        "    width_mult: float\n",
        "    l2: float\n",
        "    parameters: int\n",
        "    best_epoch: int\n",
        "    best_val_accuracy: float\n",
        "    best_val_loss: float\n",
        "    trained_samples: int\n",
        "    wall_seconds: float\n",
        "    checkpoint: str\n"
      ],
      "execution_count": 136,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-17T21:37:05.209016Z",
          "iopub.status.busy": "2026-11-17T21:37:05.208014Z",
          "iopub.status.idle": "2026-11-17T21:37:05.224605Z",
          "shell.execute_reply": "2026-11-17T21:37:05.224605Z"
        },
        "id": "task2-training-functions"
      },
      "source": [
        "def train_batch(model, batch, optimizer):\n",
        "    raw, targets, _ = batch\n",
        "    raw, targets = raw.to(device), targets.to(device)\n",
        "    optimizer.zero_grad(set_to_none=True)\n",
        "    logits = model(prepare_inputs(raw, stats))\n",
        "    loss = nn.functional.cross_entropy(logits, targets)\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "    count = len(targets)\n",
        "    correct = (logits.argmax(1) == targets).sum().item()\n",
        "    return loss.item() * count, correct, count\n",
        "\n",
        "\n",
        "def train_epoch(model, loader, optimizer, run, epoch) -> Metrics:\n",
        "    model.train()\n",
        "    loss_sum, correct, count = 0.0, 0, 0\n",
        "    for batch in tqdm(loader, desc=f\"[{epoch}/{run.epochs}] {run.name}\"):\n",
        "        batch_loss, batch_correct, batch_count = train_batch(model, batch, optimizer)\n",
        "        loss_sum += batch_loss\n",
        "        correct += batch_correct\n",
        "        count += batch_count\n",
        "    return Metrics(loss=loss_sum / count, accuracy=correct / count, samples=count)\n",
        "\n",
        "\n",
        "@torch.inference_mode()\n",
        "def evaluate(model, loader, normalization_stats=None) -> Metrics:\n",
        "    if normalization_stats is None:\n",
        "        normalization_stats = stats\n",
        "    model.eval()\n",
        "    loss_sum, correct, count = 0.0, 0, 0\n",
        "    for raw, targets, _ in loader:\n",
        "        raw, targets = raw.to(device), targets.to(device)\n",
        "        logits = model(prepare_inputs(raw, normalization_stats))\n",
        "        loss_sum += nn.functional.cross_entropy(logits, targets, reduction=\"sum\").item()\n",
        "        correct += (logits.argmax(1) == targets).sum().item()\n",
        "        count += targets.size(0)\n",
        "    return Metrics(loss=loss_sum / count, accuracy=correct / count, samples=count)\n",
        "\n",
        "\n",
        "def train_model(\n",
        "    run: Run,\n",
        "    *,\n",
        "    output_dir: Path,\n",
        "    train_ids,\n",
        "    val_ids,\n",
        ") -> tuple[list[EpochResult], RunSummary]:\n",
        "    set_seed(run.seed)\n",
        "    loaders = make_loaders(run, train_ids, val_ids)\n",
        "    model = build_model(run).to(device)\n",
        "    optimizer = torch.optim.SGD(\n",
        "        model.parameters(), lr=run.lr, momentum=run.momentum, weight_decay=run.l2\n",
        "    )\n",
        "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=run.epochs)\n",
        "    checkpoint_path = output_dir / f\"{run.name}_best.pt\"\n",
        "\n",
        "    history: list[EpochResult] = []\n",
        "    best_key, best_epoch = None, None\n",
        "    start = time.perf_counter()\n",
        "    for epoch in range(1, run.epochs + 1):\n",
        "        training = train_epoch(model, loaders.train, optimizer, run, epoch)\n",
        "        validation = evaluate(model, loaders.val)\n",
        "        history.append(\n",
        "            EpochResult(\n",
        "                epoch=epoch,\n",
        "                train_loss=training.loss,\n",
        "                train_accuracy=training.accuracy,\n",
        "                val_loss=validation.loss,\n",
        "                val_accuracy=validation.accuracy,\n",
        "            )\n",
        "        )\n",
        "\n",
        "        key = (validation.accuracy, -validation.loss)\n",
        "        if best_key is None or key > best_key:\n",
        "            best_key, best_epoch = key, epoch\n",
        "            torch.save(\n",
        "                {\n",
        "                    \"model_name\": run.model,\n",
        "                    \"epoch\": epoch,\n",
        "                    \"config\": asdict(run),\n",
        "                    \"stats\": stats,\n",
        "                    \"class_names\": class_names,\n",
        "                    \"val_loss\": validation.loss,\n",
        "                    \"val_accuracy\": validation.accuracy,\n",
        "                    \"state_dict\": {\n",
        "                        k: v.detach().cpu().clone() for k, v in model.state_dict().items()\n",
        "                    },\n",
        "                },\n",
        "                checkpoint_path,\n",
        "            )\n",
        "\n",
        "        scheduler.step()\n",
        "        pd.DataFrame(map(asdict, history)).to_csv(\n",
        "            output_dir / f\"{run.name}_history.csv\", index=False\n",
        "        )\n",
        "\n",
        "    assert best_key is not None and best_epoch is not None\n",
        "    summary = RunSummary(\n",
        "        name=run.name,\n",
        "        group=run.group,\n",
        "        model=run.model,\n",
        "        smoke=run.smoke,\n",
        "        epochs=run.epochs,\n",
        "        dropout=run.dropout,\n",
        "        width_mult=run.width_mult,\n",
        "        l2=run.l2,\n",
        "        parameters=sum(p.numel() for p in model.parameters()),\n",
        "        best_epoch=best_epoch,\n",
        "        best_val_accuracy=best_key[0],\n",
        "        best_val_loss=-best_key[1],\n",
        "        trained_samples=run.epochs * len(train_ids),\n",
        "        wall_seconds=time.perf_counter() - start,\n",
        "        checkpoint=str(checkpoint_path),\n",
        "    )\n",
        "    del model, optimizer, scheduler\n",
        "    return history, summary\n"
      ],
      "execution_count": 137,
      "outputs": []
    },
    {
      "cell_type": "code",
