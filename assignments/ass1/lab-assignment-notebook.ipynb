    "from tqdm import tqdm\n",
    "\n",
    "channel_sum = np.zeros(3)\n",
    "channel_square_sum = np.zeros(3)\n",
    "pixel_count = 0\n",
    "\n",
    "# we process images in a batch of 256\n",
    "for start in tqdm(range(0, len(train_ids), 256)):\n",
    "    pixels = database.data[train_ids[start : start + 256]].astype(np.float64) / 255\n",
    "    channel_sum += pixels.sum(axis=(0, 1, 2)) # sum across samples in a batch, image heights, image widths\n",
    "    channel_square_sum += np.square(pixels).sum(axis=(0, 1, 2))\n",
    "    pixel_count += np.prod(pixels.shape[:3])\n",
    "\n",
    "mean = channel_sum / pixel_count\n",
    "std = np.sqrt(np.maximum(channel_square_sum / pixel_count - mean**2, 1e-12))\n",
    "stats = {\"mean\": mean.tolist(), \"std\": std.tolist()}\n",
    "display(pd.DataFrame(stats, index=[\"red\", \"green\", \"blue\"]))"
   ]
  },
