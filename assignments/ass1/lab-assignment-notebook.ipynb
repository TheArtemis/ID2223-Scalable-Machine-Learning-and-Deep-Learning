    "# AlexNet\n",
    "class AlexNet(nn.Module):\n",
    "    def __init__(self, dropout: float = 0.5, width_mult: float = 1.0):\n",
    "        super().__init__()\n",
    "\n",
    "        def width(channels: int) -> int:\n",
    "            return max(8, int(round(channels * width_mult)))\n",
    "\n",
    "        c1, c2, c3, c4, c5 = map(width, (64, 192, 384, 256, 256))\n",
    "        fc1, fc2 = map(width, (1024, 512))\n",
    "        flat = c5 * 4 * 4\n",
    "\n",
    "        self.network = nn.Sequential(\n",
    "            nn.Conv2d(3, c1, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2, stride=2),\n",
    "            nn.Conv2d(c1, c2, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2, stride=2),\n",
    "            nn.Conv2d(c2, c3, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.Conv2d(c3, c4, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.Conv2d(c4, c5, kernel_size=3, stride=1, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(kernel_size=2, stride=2),\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(flat, fc1),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(p=dropout),\n",
    "            nn.Linear(fc1, fc2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(p=dropout),\n",
    "            nn.Linear(fc2, 10),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.network(x)\n",
    "\n",
    "\n",
    "AlexNet()(torch.randn(2, 3, 32, 32)).shape\n"
   ]
