        "id": "evaluate-best-checkpoints"
      },
      "source": [
        "def evaluate_best_checkpoints(output_dir: Path) -> pd.DataFrame:\n",
        "    with np.load(output_dir / \"split_ids.npz\") as split:\n",
        "        train_ids = split[\"train_ids\"]\n",
        "        val_ids = split[\"val_ids\"]\n",
        "\n",
        "    comparison = pd.read_csv(output_dir / \"comparison.csv\")\n",
        "    rows = []\n",
        "    for name in comparison[\"name\"]:\n",
        "        checkpoint = torch.load(\n",
        "            output_dir / f\"{name}_best.pt\", map_location=\"cpu\", weights_only=True\n",
        "        )\n",
        "        run = Run(**checkpoint[\"config\"])\n",
        "        loaders = make_loaders(run, train_ids, val_ids)\n",
        "        model = build_model(run).to(device)\n",
        "        model.load_state_dict(checkpoint[\"state_dict\"])\n",
        "\n",
        "        training = evaluate(model, loaders.train_eval, checkpoint[\"stats\"])\n",
        "        val_accuracy = checkpoint[\"val_accuracy\"]\n",
        "        rows.append(\n",
        "            {\n",
        "                \"name\": name,\n",
        "                \"epoch\": checkpoint[\"epoch\"],\n",
        "                \"train_samples\": training.samples,\n",
        "                \"train_loss\": training.loss,\n",
        "                \"train_accuracy\": training.accuracy,\n",
        "                \"val_samples\": len(val_ids),\n",
        "                \"val_loss\": checkpoint[\"val_loss\"],\n",
        "                \"val_accuracy\": val_accuracy,\n",
        "                \"accuracy_gap_pp\": 100 * (training.accuracy - val_accuracy),\n",
        "            }\n",
        "        )\n",
        "\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        ""
      ],
      "execution_count": null,
      "outputs": []
    },
