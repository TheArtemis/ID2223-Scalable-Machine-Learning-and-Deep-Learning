    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "groups = [\"capacity\", \"l2\", \"dropout\"]\n",
        "fig, axes = plt.subplots(len(groups), 2, figsize=(12, 3.8 * len(groups)), sharex=True)\n",
        "\n",
        "for row, group in enumerate(groups):\n",
        "    for name in t3_group_members[group]:\n",
        "        history = t3_histories[name]\n",
        "        epochs = [point.epoch for point in history]\n",
        "        line, = axes[row, 0].plot(\n",
        "            epochs, [point.train_loss for point in history], marker=\"o\", label=f\"{name} train\"\n",
        "        )\n",
        "        color = line.get_color()\n",
        "        axes[row, 0].plot(\n",
        "            epochs, [point.val_loss for point in history], \"--o\", color=color, label=f\"{name} val\"\n",
        "        )\n",
        "        axes[row, 1].plot(\n",
        "            epochs, [point.train_accuracy for point in history], \"-o\", color=color, label=f\"{name} train\"\n",
        "        )\n",
        "        axes[row, 1].plot(\n",
        "            epochs, [point.val_accuracy for point in history], \"--o\", color=color, label=f\"{name} val\"\n",
        "        )\n",
        "    axes[row, 0].set_ylabel(f\"{group}\\ncross-entropy\")\n",
        "    axes[row, 1].set_ylabel(f\"{group}\\naccuracy\")\n",
        "    axes[row, 1].set_ylim(0, 1)\n",
        "    for ax in axes[row]:\n",
        "        ax.grid(alpha=0.25)\n",
        "        ax.legend(fontsize=8)\n",
        "\n",
        "axes[-1, 0].set_xlabel(\"Epoch\")\n",
        "axes[-1, 1].set_xlabel(\"Epoch\")\n",
        "fig.suptitle(f\"T3 - {'smoke' if T3_SMOKE else 'full'} runs\")\n",
        "fig.tight_layout()\n",
        "fig.savefig(t3_output_dir / \"learning_curves.png\", dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n"
      ],
