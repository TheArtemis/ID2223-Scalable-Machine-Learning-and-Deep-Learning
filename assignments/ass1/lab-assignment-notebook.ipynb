      "source": [
        "class RawImages(Dataset):\n",
        "    def __init__(self, dataset, ids):\n",
        "        self.dataset = dataset\n",
        "        self.ids = list(map(int, ids))\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.ids)\n",
        "\n",
        "    def __getitem__(self, idx):  # ty: ignore[lost-keyword-for-regular-parameter]\n",
        "        image_id = self.ids[idx]\n",
        "        image, target = self.dataset[image_id]\n",
        "        return TF.to_tensor(image), int(target), image_id"
      ],
      "execution_count": 127,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-17T21:37:04.644447Z",
          "iopub.status.busy": "2026-11-17T21:37:04.643447Z",
          "iopub.status.idle": "2026-11-17T21:37:04.647776Z",
          "shell.execute_reply": "2026-11-17T21:37:04.647776Z"
        }
      },
      "source": [
        "def prepare_inputs(raw, stats):\n",
        "    mean = raw.new_tensor(stats[\"mean\"])[None, :, None, None]\n",
        "    std = raw.new_tensor(stats[\"std\"])[None, :, None, None]\n",
        "    return (raw - mean) / std"
      ],
      "execution_count": 128,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "**Q: Which preprocessing steps are needed for the two architectures?**\n",
        "\n",
        "Both AlexNet and ResNet use the CIFAR-10 adaptations from Part A9, so they take native 3x32x32 inputs. We apply the same preprocessing to both: convert uint8 images to float tensors in [0, 1], then normalize each channel with the mean and standard deviation computed on the training split only.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "**Q: How is the dataset preprocessed and splitted?**\n",
        "\n",
        "We split the official training set into 45,000 training and 5,000 validation images (stratified 90/10, seed 2223). The official 10,000-image test set is held out for final evaluation. Images are converted to [0, 1] tensors and normalized with training-set mean/std."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-17T21:37:04.671336Z",
          "iopub.status.busy": "2026-11-17T21:37:04.671336Z",
          "iopub.status.idle": "2026-11-17T21:37:04.682191Z",
          "shell.execute_reply": "2026-11-17T21:37:04.682191Z"
        }
      },
      "source": [
        "import random\n",
        "from dataclasses import asdict, dataclass, replace\n",
        "\n",
        "\n",
        "def set_seed(seed):\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "    torch.backends.cudnn.benchmark = False\n",
        "    torch.backends.cudnn.deterministic = True\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Run:\n",
        "    name: str\n",
        "    model: str = \"AlexNet\"\n",
        "    group: str = \"baseline\"\n",
        "    seed: int = 2223\n",
        "    epochs: int = 20\n",
        "    batch_size: int = 64\n",
        "    lr: float = 0.01\n",
        "    momentum: float = 0.9\n",
        "    l2: float = 0.0\n",
        "    dropout: float = 0.5\n",
        "    width_mult: float = 1.0\n",
        "    augmentation: bool = False\n",
        "    smoke: bool = False\n",
        "\n",
        "    def get_smoke(self, epochs: int = 1) -> \"Run\":\n",
        "        return replace(self, smoke=True, epochs=epochs)\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Loaders:\n",
        "    train: DataLoader\n",
        "    train_eval: DataLoader\n",
        "    val: DataLoader\n",
        "    test: DataLoader | None = None\n",
        "\n",
        "\n",
        "def make_loaders(run: Run, train_subset, val_subset, *, include_test=False) -> Loaders:\n",
        "    generator = torch.Generator()\n",
        "    generator.manual_seed(run.seed)\n",
        "    loaders = Loaders(\n",
        "        train=DataLoader(\n",
        "            RawImages(database, train_subset),\n",
        "            batch_size=run.batch_size,\n",
        "            shuffle=True,\n",
        "            num_workers=0,\n",
        "            pin_memory=device.type == \"cuda\",\n",
        "            generator=generator,\n",
        "        ),\n",
        "        train_eval=DataLoader(\n",
        "            RawImages(database, train_subset),\n",
        "            batch_size=run.batch_size,\n",
        "            shuffle=False,\n",
        "            num_workers=0,\n",
        "            pin_memory=device.type == \"cuda\",\n",
        "        ),\n",
        "        val=DataLoader(\n",
        "            RawImages(database, val_subset),\n",
        "            batch_size=run.batch_size,\n",
        "            shuffle=False,\n",
        "            num_workers=0,\n",
        "            pin_memory=device.type == \"cuda\",\n",
        "        ),\n",
        "    )\n",
        "    if include_test:\n",
        "        loaders.test = DataLoader(\n",
        "            RawImages(test_database, test_ids),\n",
        "            batch_size=run.batch_size,\n",
        "            shuffle=False,\n",
        "            num_workers=0,\n",
        "            pin_memory=device.type == \"cuda\",\n",
        "        )\n",
        "    return loaders\n",
        "\n",
        "\n",
        "inspect_run = Run(name=\"inspect\", seed=SEED, batch_size=128, epochs=1)\n",
        "set_seed(inspect_run.seed)\n",
        "loaders = make_loaders(inspect_run, train_ids, val_ids, include_test=True)\n",
        "print(\n",
        "    f\"{inspect_run.name}: \"\n",
        "    f\"{len(loaders.train)} train / {len(loaders.val)} val / {len(loaders.test)} test batches\"\n",
        ")\n"
      ],
      "execution_count": 140,
      "outputs": [
        {
          "output_type": "stream",
          "text": [
            "inspect: 352 train / 40 val / 79 test batches\n"
          ],
