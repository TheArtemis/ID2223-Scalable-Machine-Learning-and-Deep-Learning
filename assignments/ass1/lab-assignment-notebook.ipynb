        "\n",
        "            # Stage 4\n",
        "            BasicBlock(256, 512, 2),\n",
        "            BasicBlock(512, 512, 1),\n",
        "            nn.AdaptiveAvgPool2d(output_size=1),\n",
        "            nn.Flatten(),\n",
        "            nn.Linear(\n",
        "                in_features=512,\n",
        "                out_features=10\n",
        "            )\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.network(x)\n",
