    "# Make a new data loader for this particular augmentation test\n",
    "def make_loaders(\n",
    "    run: Run,\n",
    "    train_subset,\n",
    "    val_subset,\n",
    "    *,\n",
    "    include_test=False,\n",
    ") -> Loaders:\n",
    "\n",
    "    generator = torch.Generator().manual_seed(run.seed)\n",
    "\n",
    "    # Clean training images, also used for training-set evaluation.\n",
    "    clean_train = RawImages(database, train_subset)\n",
    "\n",
    "    # Apply augmentation only when the run requests it.\n",
    "    training_data = (\n",
    "        AugmentedImages(clean_train)\n",
    "        if run.augmentation\n",
    "        else clean_train\n",
    "    )\n",
    "\n",
    "    def make_loader(dataset, *, shuffle=False):\n",
    "        return DataLoader(\n",
    "            dataset,\n",
    "            batch_size=run.batch_size,\n",
    "            shuffle=shuffle,\n",
    "            num_workers=0,\n",
    "            pin_memory=device.type == \"cuda\",\n",
    "            generator=generator if shuffle else None,\n",
    "        )\n",
    "\n",
    "    return Loaders(\n",
    "        train=make_loader(training_data, shuffle=True),\n",
    "        train_eval=make_loader(clean_train),\n",
    "        val=make_loader(RawImages(database, val_subset)),\n",
    "        test=(\n",
    "            make_loader(RawImages(test_database, test_ids))\n",
    "            if include_test\n",
    "            else None\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"Data loaders updated to support training augmentation.\")"
   ]
